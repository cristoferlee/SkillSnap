@using SkillSnap.Client.Models
@using SkillSnap.Client.Services
@inject ProjectService ProjectService
@inject SkillService SkillService
@inject AuthService AuthService
@inject UserSessionService UserSession
@inject IJSRuntime JSRuntime
@implements IDisposable

<section class="mb-5">
    <h2>Projects</h2>

    @if (isLoading)
    {
        <p>Loading projects...</p>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }
    else if (projects.Count == 0)
    {
        <p>No projects are available.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var project in projects)
            {
                <div class="col-12 col-md-6"
                     @key="project.Id">

                    <div class="card h-100 project-card
                                @(selectedProjectId == project.Id
                                    ? "project-card-selected"
                                    : null)"
                         role="button"
                         tabindex="0"
                         aria-expanded="@(selectedProjectId == project.Id)"
                         @onclick="() => ToggleProjectDetails(project.Id)"
                         @onkeydown="args => HandleProjectKeyDown(
                             project.Id, args)">
                        <img src="@project.ImageUrl"
                            alt="Preview of @project.Title"
                            class="card-img-top project-image"
                            width="600"
                            height="200"
                            onerror="this.onerror=null;this.src='https://placehold.co/600x200?text=Project';" />

                        <div class="card-body">
                            <h3 class="h5">
                                @project.Title
                            </h3>

                            <p class="card-text">
                                @project.Description
                            </p>

                            @if (ShowAdminControls &&
                                AuthService.IsInRole("Admin"))
                            {
                                <div class="d-flex gap-2">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            disabled="@isSaving"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => BeginEdit(project)">

                                        Edit
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            disabled="@isSaving"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => DeleteProjectAsync(project)">

                                        Delete
                                    </button>
                                </div>
                            }
                        </div>

                        @if (selectedProjectId == project.Id)
                        {
                            <div class="card-footer project-details">
                                @if (project.Skills.Count > 0)
                                {
                                    <div class="project-skills"
                                         aria-label="Technologies used">
                                        @foreach (var skill in project.Skills)
                                        {
                                            <span class="project-skill"
                                                  @key="skill.Id">
                                                @skill.Name
                                            </span>
                                        }
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(project.LiveUrl) ||
                                    !string.IsNullOrWhiteSpace(project.RepositoryUrl))
                                {
                                    <div class="project-links">
                                        @if (!string.IsNullOrWhiteSpace(project.LiveUrl))
                                        {
                                            <a class="project-link"
                                               href="@project.LiveUrl"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               @onclick:stopPropagation="true">
                                                Live site
                                            </a>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(project.RepositoryUrl))
                                        {
                                            <a class="project-link"
                                               href="@project.RepositoryUrl"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               @onclick:stopPropagation="true">
                                                Source code
                                            </a>
                                        }
                                    </div>
                                }

                                @if (project.Skills.Count == 0 &&
                                    string.IsNullOrWhiteSpace(project.LiveUrl) &&
                                    string.IsNullOrWhiteSpace(project.RepositoryUrl))
                                {
                                    <p class="project-details-empty">
                                        More project details coming soon.
                                    </p>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @if (ShowAdminControls &&
        AuthService.IsInRole("Admin"))
    {
        @if (editingProject is not null)
        {
            <h3 class="h5 mt-4">Edit project</h3>

            <EditForm Model="editingProject"
                      OnValidSubmit="UpdateProjectAsync">

                <DataAnnotationsValidator />

                <div class="mb-2">
                    <label for="edit-project-title"
                           class="form-label">
                        Title
                    </label>

                    <InputText id="edit-project-title"
                               class="form-control"
                               @bind-Value="editingProject.Title" />

                    <ValidationMessage
                        For="() => editingProject.Title" />
                </div>

                <div class="mb-2">
                    <label for="edit-project-description"
                           class="form-label">
                        Description
                    </label>

                    <InputText id="edit-project-description"
                               class="form-control"
                               @bind-Value="editingProject.Description" />

                    <ValidationMessage
                        For="() => editingProject.Description" />
                </div>

                <div class="mb-2">
                    <label for="edit-project-image"
                           class="form-label">
                        Image URL
                    </label>

                    <InputText id="edit-project-image"
                               class="form-control"
                               @bind-Value="editingProject.ImageUrl" />

                    <ValidationMessage
                        For="() => editingProject.ImageUrl" />
                </div>

                <div class="mb-2">
                    <label for="edit-project-live-url"
                           class="form-label">
                        Live site URL
                    </label>

                    <InputText id="edit-project-live-url"
                               class="form-control"
                               @bind-Value="editingProject.LiveUrl" />

                    <ValidationMessage
                        For="() => editingProject.LiveUrl" />
                </div>

                <div class="mb-2">
                    <label for="edit-project-repository-url"
                           class="form-label">
                        Repository URL
                    </label>

                    <InputText id="edit-project-repository-url"
                               class="form-control"
                               @bind-Value="editingProject.RepositoryUrl" />

                    <ValidationMessage
                        For="() => editingProject.RepositoryUrl" />
                </div>

                <fieldset class="mb-3">
                    <legend class="form-label">Skills used</legend>

                    @if (availableSkills.Count == 0)
                    {
                        <p class="text-muted small">
                            Add skills before assigning them to a project.
                        </p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var skill in availableSkills)
                            {
                                <label class="form-check">
                                    <input id="@($"edit-skill-{skill.Id}")"
                                           class="form-check-input"
                                           type="checkbox"
                                           checked="@editingProject.SkillIds.Contains(skill.Id)"
                                           @onchange="args => SetSkillSelection(
                                               editingProject,
                                               skill.Id,
                                               args)" />

                                    <span class="form-check-label">
                                        @skill.Name
                                    </span>
                                </label>
                            }
                        </div>
                    }
                </fieldset>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@isSaving">

                        @(isSaving ? "Saving..." : "Save changes")
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            disabled="@isSaving"
                            @onclick="CancelEdit">

                        Cancel
                    </button>
                </div>
            </EditForm>
        }
        else
        {
            <h3 class="h5 mt-4">Add a project</h3>

            <EditForm Model="newProject"
                      OnValidSubmit="AddProjectAsync">

                <DataAnnotationsValidator />

                <div class="mb-2">
                    <label for="project-title"
                           class="form-label">
                        Title
                    </label>

                    <InputText id="project-title"
                               class="form-control"
                               @bind-Value="newProject.Title" />

                    <ValidationMessage
                        For="() => newProject.Title" />
                </div>

                <div class="mb-2">
                    <label for="project-description"
                           class="form-label">
                        Description
                    </label>

                    <InputText id="project-description"
                               class="form-control"
                               @bind-Value="newProject.Description" />

                    <ValidationMessage
                        For="() => newProject.Description" />
                </div>

                <div class="mb-2">
                    <label for="project-image"
                           class="form-label">
                        Image URL
                    </label>

                    <InputText id="project-image"
                               class="form-control"
                               @bind-Value="newProject.ImageUrl" />

                    <ValidationMessage
                        For="() => newProject.ImageUrl" />
                </div>

                <div class="mb-2">
                    <label for="project-live-url"
                           class="form-label">
                        Live site URL
                    </label>

                    <InputText id="project-live-url"
                               class="form-control"
                               @bind-Value="newProject.LiveUrl" />

                    <ValidationMessage
                        For="() => newProject.LiveUrl" />
                </div>

                <div class="mb-2">
                    <label for="project-repository-url"
                           class="form-label">
                        Repository URL
                    </label>

                    <InputText id="project-repository-url"
                               class="form-control"
                               @bind-Value="newProject.RepositoryUrl" />

                    <ValidationMessage
                        For="() => newProject.RepositoryUrl" />
                </div>

                <fieldset class="mb-3">
                    <legend class="form-label">Skills used</legend>

                    @if (availableSkills.Count == 0)
                    {
                        <p class="text-muted small">
                            Add skills before assigning them to a project.
                        </p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var skill in availableSkills)
                            {
                                <label class="form-check">
                                    <input id="@($"new-skill-{skill.Id}")"
                                           class="form-check-input"
                                           type="checkbox"
                                           checked="@newProject.SkillIds.Contains(skill.Id)"
                                           @onchange="args => SetSkillSelection(
                                               newProject,
                                               skill.Id,
                                               args)" />

                                    <span class="form-check-label">
                                        @skill.Name
                                    </span>
                                </label>
                            }
                        </div>
                    }
                </fieldset>

                <button type="submit"
                        class="btn btn-primary"
                        disabled="@isSaving">

                    @(isSaving ? "Adding..." : "Add project")
                </button>
            </EditForm>
        }
    }
</section>

@code {
    [Parameter]
    public bool ShowAdminControls { get; set; }
    private List<Project> projects = [];
    private List<Skill> availableSkills = [];
    private Project newProject = CreateEmptyProject();
    private Project? editingProject;
    private int? selectedProjectId;
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        AuthService.AuthenticationChanged +=
            HandleAuthenticationChanged;

        await LoadProjectsAsync();
    }

    private async Task LoadProjectsAsync()
    {
        try
        {
            errorMessage = null;
            projects = await ProjectService.GetProjectsAsync();
            availableSkills = await SkillService.GetSkillsAsync();
        }
        catch (HttpRequestException)
        {
            errorMessage = "Projects could not be loaded.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddProjectAsync()
    {
        try
        {
            isSaving = true;
            errorMessage = null;

            await ProjectService.AddProjectAsync(newProject);

            newProject = CreateEmptyProject();
            await LoadProjectsAsync();
        }
        catch (HttpRequestException)
        {
            errorMessage = "The project could not be added.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void BeginEdit(Project project)
    {
        editingProject = new Project
        {
            Id = project.Id,
            Title = project.Title,
            Description = project.Description,
            ImageUrl = project.ImageUrl,
            LiveUrl = project.LiveUrl,
            RepositoryUrl = project.RepositoryUrl,
            SkillIds = [.. project.SkillIds]
        };

        UserSession.SetCurrentProject(project.Title);
        errorMessage = null;
    }

    private void CancelEdit()
    {
        editingProject = null;
        UserSession.SetCurrentProject(null);
    }

    private async Task UpdateProjectAsync()
    {
        if (editingProject is null)
        {
            return;
        }

        try
        {
            isSaving = true;
            errorMessage = null;

            await ProjectService.UpdateProjectAsync(
                editingProject);

            editingProject = null;
            UserSession.SetCurrentProject(null);

            await LoadProjectsAsync();
        }
        catch (HttpRequestException)
        {
            errorMessage = "The project could not be updated.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteProjectAsync(Project project)
    {
        var confirmed =
            await JSRuntime.InvokeAsync<bool>(
                "confirm",
                $"Delete the project '{project.Title}'?");

        if (!confirmed)
        {
            return;
        }

        try
        {
            isSaving = true;
            errorMessage = null;

            await ProjectService.DeleteProjectAsync(
                project.Id);

            if (editingProject?.Id == project.Id)
            {
                editingProject = null;
                UserSession.SetCurrentProject(null);
            }

            await LoadProjectsAsync();
        }
        catch (HttpRequestException)
        {
            errorMessage = "The project could not be deleted.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static Project CreateEmptyProject()
    {
        return new Project();
    }

    private static void SetSkillSelection(
        Project project,
        int skillId,
        ChangeEventArgs args)
    {
        var isSelected =
            args.Value is bool selected && selected;

        if (isSelected &&
            !project.SkillIds.Contains(skillId))
        {
            project.SkillIds.Add(skillId);
        }
        else if (!isSelected)
        {
            project.SkillIds.Remove(skillId);
        }
    }

    private void ToggleProjectDetails(int projectId)
    {
        selectedProjectId =
            selectedProjectId == projectId
                ? null
                : projectId;
    }

    private void HandleProjectKeyDown(
        int projectId,
        KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " ")
        {
            ToggleProjectDetails(projectId);
        }
    }

    private void HandleAuthenticationChanged()
    {
        if (!AuthService.IsAuthenticated)
        {
            editingProject = null;
            UserSession.SetCurrentProject(null);
        }

        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthService.AuthenticationChanged -=
            HandleAuthenticationChanged;
    }
}
